---
layout: base.njk
mainClass: tight
pagination:
  data: repos
  size: 1
  alias: repo
permalink: "/projects/{{ repo.slug }}/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ repo.name }}"
  summary: "{{ repo.description }}"
scripts:
  - /js/file-tree.js
---
<p class="crumb"><a href="/projects/">프로젝트</a> / {{ repo.name }}</p>
<h1 class="project-title">{{ repo.name }}</h1>
{% if repo.description %}<p class="project-desc">{{ repo.description | escape }}</p>{% endif %}
<p class="meta-line project-meta">
{%- if repo.metaLine %}{{ repo.metaLine }} · {% endif -%}
{%- if repo.pushed %}마지막 커밋 {{ repo.pushed | dotDate }} · {% endif -%}
<a href="{{ repo.url }}">GitHub에서 보기 ↗</a>
</p>

<div class="sections">
{% if repo.readmeHtml %}
<section class="section">
<div class="section-head"><h2>README</h2></div>
<div class="section-body readme">
{{ repo.readmeHtml | safe }}
</div>
</section>
{% endif %}

<section class="section section--code">
<div class="section-code-head">
<h2>코드</h2>
<p class="row-date">{{ repo.branch }}{% if repo.sha %} · {{ repo.sha }}{% endif %}</p>
</div>
{% if repo.tree.length %}
<div class="explorer">
<nav class="explorer-tree" aria-label="파일 목록">
{{ repo.tree | repoTree(repo.slug) | safe }}
</nav>
<div class="explorer-code">
{% if repo.defaultPath %}
{% set df = repo.contentMap[repo.defaultPath] %}
<div class="explorer-code-head">
<span class="path">{{ repo.defaultPath }}</span>
<span class="explorer-code-meta">{% if df.total %}{{ df.total }} lines · {% endif %}<a href="{{ df.url }}">GitHub에서 보기 ↗</a></span>
</div>
{% if df.isImage %}
<div class="explorer-preview"><img src="{{ df.url | replace('/blob/', '/raw/') }}" alt="{{ repo.defaultPath }}"></div>
{% elif df.isBinary or df.noPreview %}
<div class="explorer-preview"><p class="empty">미리보기를 지원하지 않는 파일입니다 · <a href="{{ df.url }}">GitHub에서 보기 ↗</a></p></div>
{% elif df.lines %}
<pre class="code-body"><code>{% for line in df.lines %}<span class="code-line"><span class="ln">{{ loop.index }}</span><span class="lc">{{ line | escape }}</span></span>{% endfor %}</code></pre>
{% if df.truncated %}<p class="code-more"><a href="{{ df.url }}">나머지 {{ df.total - df.lines.length }}줄은 GitHub에서 보기 ↗</a></p>{% endif %}
{% else %}
<div class="explorer-preview"><p class="empty">미리보기를 지원하지 않는 파일입니다 · <a href="{{ df.url }}">GitHub에서 보기 ↗</a></p></div>
{% endif %}
{% endif %}
</div>
</div>
{% endif %}
</section>

{% if repo.commits.length %}
<section class="section">
<div class="section-head"><h2>최근 커밋</h2></div>
<ol class="section-body commits">
{%- for c in repo.commits %}
<li><a class="msg" href="{{ c.url }}">{{ c.message | escape }}</a><span class="when">{{ c.date | dotDate }}</span></li>
{%- endfor %}
</ol>
</section>
{% endif %}
</div>
