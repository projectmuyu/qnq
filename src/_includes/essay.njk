---
layout: base.njk
mainClass: tight
---
<article class="article">
<h1>{{ title }}</h1>
<div class="byline">
<p class="name">{{ author or site.author }}</p>
<p>{{ site.authorBio }}</p>
</div>
<div class="article-body">
{{ content | safe }}
</div>
</article>
{% set older = collections.essays | getNextCollectionItem(page) %}
<nav class="pager" aria-label="이전 글">
{% if older %}<a href="{{ older.url }}">← {{ older.data.title }}</a>{% else %}<span></span>{% endif %}
<a class="muted" href="/essays/">목록으로</a>
</nav>
